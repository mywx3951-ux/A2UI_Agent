# Agent 模式：mock 使用 Mock 协议，openai 调用模型（DeepSeek 同样走 openai 模式）
A2UI_AGENT_MODE=mock
# Mock 数据文件：random 表示每次请求随机挑选，也可指定具体文件名（如 shopping-cart.json）
A2UI_MOCK_FILE=random

# 模型配置：DeepSeek 兼容 OpenAI 协议
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
# 也可用 deepseek-reasoner
OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_TIMEOUT_MS=60000

# SSE 流式输出
STREAM_CHUNK_SIZE=80
STREAM_INTERVAL_MS=60

PORT=3000
